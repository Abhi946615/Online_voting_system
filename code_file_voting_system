-- displaying election result
select

candidate_name,
party_name,
total_votes

from candidates

order by total_votes desc;


-- displaying winner
select

candidate_name,
party_name,
total_votes

from candidates

order by total_votes desc

limit 1;


-- displaying voter and candidate details
select

voters.voter_name,

candidates.candidate_name,

candidates.party_name

from votes

join voters

on votes.voter_id = voters.voter_id

join candidates

on votes.candidate_id = candidates.candidate_id;


